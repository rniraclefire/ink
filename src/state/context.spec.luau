const lest = require("@lest")
const describe, it, expect = lest.describe, lest.it, lest.expect

const context = require("./context")
const scope = require("./scope")

describe("context", function()
	it("returns the default when nothing is provided", function()
		const ctx = context.new("default")
		expect(ctx:get(scope.new())).toBe("default")
	end)

	it("returns a value provided to the same scope", function()
		const ctx = context.new("default")
		const s = scope.new()
		ctx:provide(s, "provided")
		expect(ctx:get(s)).toBe("provided")
	end)

	it("returns a value provided to an ancestor", function()
		const ctx = context.new("default")
		const s = scope.new()
		ctx:provide(s, "root")
		expect(ctx:get(s:key("a"):key("b"))).toBe("root")
	end)

	it("prefers the closest provided value", function()
		const ctx = context.new("default")
		const s = scope.new()
		const a = s:key("a")
		ctx:provide(s, "root")
		ctx:provide(a, "inner")
		expect(ctx:get(a:key("b"))).toBe("inner")
		expect(ctx:get(s:key("sibling"))).toBe("root")
	end)

	it("returns the provided value", function()
		const ctx = context.new(0)
		expect(ctx:provide(scope.new(), 5)).toBe(5)
	end)

	it("forgets values that weren't provided this frame", function()
		const ctx = context.new("default")
		const s = scope.new()
		ctx:provide(s, "provided")
		s:next(1 / 60)
		expect(ctx:get(s)).toBe("default")
	end)

	it("reads the ancestor's value before a scope provides its own this frame", function()
		const ctx = context.new("default")
		const s = scope.new()
		const a = s:key("a")
		ctx:provide(a, "stale")
		s:next(1 / 60)
		ctx:provide(s, "root")
		const a_now = s:key("a")
		expect(ctx:get(a_now)).toBe("root")
		ctx:provide(a_now, "fresh")
		expect(ctx:get(a_now)).toBe("fresh")
	end)

	it("clears a provided value", function()
		const ctx = context.new("default")
		const s = scope.new()
		ctx:provide(s, "provided")
		ctx:clear(s)
		expect(ctx:get(s)).toBe("default")
	end)

	it("keeps separate contexts independent", function()
		const theme = context.new("light")
		const locale = context.new("en")
		const s = scope.new()
		theme:provide(s, "dark")
		expect(locale:get(s)).toBe("en")
	end)
end)

return nil
